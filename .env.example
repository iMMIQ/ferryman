# Ferryman standalone deployment configuration.
# Copy to .env next to docker-compose.standalone.yml and adjust.

# Shared bearer secret between web and agent (required, >= 16 chars).
# Generate a fresh one: openssl rand -hex 32
FERRYMAN_AGENT_TOKEN=please-run-openssl-rand-hex-32-and-paste-here

# Host port for the web UI.
FERRYMAN_WEB_PORT=8080

# Host directories for the job database, the documents library and the second
# ("remote fs") library. Both libraries get a local-development-user/ subdir.
FERRYMAN_DATA_DIR=./data
FERRYMAN_DOCS_DIR=./documents
FERRYMAN_REMOTEFS_DIR=./remotefs

# Model weights and vLLM/Triton caches. Weights are large (7B FP8 ~9 GiB,
# 30B FP8 ~33 GiB); point FERRYMAN_MODELS_DIR at a big disk.
FERRYMAN_MODELS_DIR=./models
FERRYMAN_AGENT_CACHE_DIR=./agent-cache

# vLLM base image for the agent. Default is the Jetson AGX Orin build
# (aarch64 + CUDA 12.6) the presets were tuned for.
#VLLM_BASE_IMAGE=docker.io/catdogai/lzc-aipod-vllm:agxorin-cu126-src-18f658bb3185-20260703

# LD_PRELOAD applied to the vLLM child process. Default is the Jetson NVIDIA
# libcuda path. On non-Jetson hosts set it to an empty value (FERRYMAN_VLLM_LD_PRELOAD=)
# and switch VLLM_BASE_IMAGE to a matching vLLM image.
#FERRYMAN_VLLM_LD_PRELOAD=/usr/lib/aarch64-linux-gnu/nvidia/libcuda.so.1

# GPU memory flags (utilization, KV cache size) are derived automatically from
# the actual GPU memory and the model weights on disk — nothing to configure.
# Escape hatch for exotic vLLM builds where the flag probe misbehaves:
# 0 never passes --kv-cache-memory-bytes, 1 always passes it.
#FERRYMAN_VLLM_KV_CACHE_FLAG=0
