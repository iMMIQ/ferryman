# Ferryman standalone deployment configuration.
# Copy to .env next to docker-compose.standalone.yml and adjust.

# Shared bearer secret between web and agent (required, >= 16 chars).
# Generate a fresh one: openssl rand -hex 32
FERRYMAN_AGENT_TOKEN=please-run-openssl-rand-hex-32-and-paste-here

# Host port for the web UI.
FERRYMAN_WEB_PORT=8080

# Host directories for the job database, the documents library and the second
# ("remote fs") library. Both libraries get a local-development-user/ subdir.
FERRYMAN_DATA_DIR=./data
FERRYMAN_DOCS_DIR=./documents
FERRYMAN_REMOTEFS_DIR=./remotefs

# Persistent AI Pod model downloads (Index 2B ~1.3 GB, 9B ~5.5 GB, 35B ~19 GB).
FERRYMAN_MODELS_DIR=./models
FERRYMAN_AGENT_CACHE_DIR=./agent-cache

# The ARM64 agent image bundles Orinfer 0.2.0 and all three Index execution packages.
# Ferryman starts its own model process on 127.0.0.1:18088 inside the Agent
# container. The inference listener is never published to the host.
