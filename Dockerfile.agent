# AI Pod resources already contain the installed Orinfer execution packages.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY build/aipod/agxorin/ferryman-agent /usr/local/bin/ferryman-agent
COPY build/aipod/agxorin/orinfer /opt/orinfer
ENV PATH=/opt/orinfer/bin:$PATH \
    ORINFER_EXECUTION_CACHE=/opt/orinfer/packages \
    FERRYMAN_AGENT_LISTEN=0.0.0.0:8090 \
    FERRYMAN_MODEL_ROOT=/models \
    FERRYMAN_ORINFER_ENDPOINT=http://127.0.0.1:18088 \
    FERRYMAN_IDLE_TIMEOUT_SECONDS=600 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    RUST_LOG=info
EXPOSE 8090
ENTRYPOINT ["ferryman-agent"]
