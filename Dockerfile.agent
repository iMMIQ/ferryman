# Optional local image assembly; the Lazycat Agent LPK exports resources only.
FROM docker.io/catdogai/lzc-aipod-vllm:agxorin-cu126-src-18f658bb3185-20260703@sha256:079f2ab5a3f19da5fbdf930476fed73625c3d47085407280fbee48c4293279be
COPY build/aipod/agxorin/ferryman-agent /usr/local/bin/ferryman-agent
ENV FERRYMAN_AGENT_LISTEN=0.0.0.0:8090 \
    FERRYMAN_MODEL_ROOT=/models \
    FERRYMAN_IDLE_TIMEOUT_SECONDS=600 \
    RUST_LOG=info \
    LD_PRELOAD=
EXPOSE 8090
ENTRYPOINT ["ferryman-agent"]
