# Standalone ferryman-web image for the single-machine Docker deployment.
# Built by docker-compose.standalone.yml; the Lazycat LPK keeps using the
# root Dockerfile.web with build-release.sh artifacts.
# syntax=docker/dockerfile:1

# The alpine/musl builder produces static binaries independent of the runtime
# image's glibc (the agent's vLLM base image is older than Debian builders).
FROM lukemathwalker/cargo-chef:latest-rust-1-alpine AS chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
# Build both binaries here; the stages are identical to Dockerfile.agent so
# dependencies are compiled once and shared through the build cache.
RUN cargo build --release --bin ferryman-web --bin ferryman-agent \
    && strip target/release/ferryman-web target/release/ferryman-agent

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/ferryman-web /usr/local/bin/ferryman-web
COPY web /app/web
ENV FERRYMAN_WEB_LISTEN=0.0.0.0:8080 \
    FERRYMAN_WEB_DIR=/app/web \
    RUST_LOG=info
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ferryman-web"]
